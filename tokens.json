  "metadata": {
    "name": "PropertyFlow Design System",
    "version": "1.0.0",
    "description": "Production-ready Material Design 3 inspired design token system with a modern, minimalist, sophisticated visual identity centered around Deep Indigo (#4F46E5).",
    "author": "Design Systems Engineer & Product Designer",
    "principles": [
      "Material Design 3 structural and accessibility foundation",
      "Modern, minimalist, calm, premium and product-focused visual language",
      "Strict 3-layer architecture: Primitives, Semantics, Components",
      "WCAG 2.2 AA contrast compliance and 44px minimum touch target support",
      "Predictable camelCase naming convention and zero arbitrary values"
    ],
    "brand": {
      "name": "Deep Indigo",
      "primaryColor": "#4F46E5"
    }
  },
